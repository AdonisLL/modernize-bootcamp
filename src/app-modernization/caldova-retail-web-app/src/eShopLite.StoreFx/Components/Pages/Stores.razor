@page "/stores"
@page "/home/stores"
@rendermode AppRenderModes.InteractiveServerNoPrerender
@inject IStoreService StoreService

<PageTitle>Stores &mdash; eShopLite</PageTitle>

<div class="page-head">
    <h1><i class="bi bi-geo-alt"></i> Stores</h1>
    <p class="text-muted mb-0">This component demonstrates showing stores data.</p>
</div>

@if (_error)
{
    <div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> Unable to load stores. The catalogue database is not available.</div>
}
else if (_stores is null)
{
    <div class="loading-state"><span class="spinner-border text-primary" role="status"></span><span>Loading store information&hellip;</span></div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var store in _stores)
        {
            <div class="col">
                <div class="store-card h-100">
                    <div class="store-icon"><i class="bi bi-shop-window"></i></div>
                    <div>
                        <h2 class="h5 mb-1">@store.Name</h2>
                        <p class="mb-1 text-muted"><i class="bi bi-pin-map"></i> @store.City, @store.State</p>
                        <p class="mb-0 store-hours"><i class="bi bi-clock"></i> @store.Hours</p>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<StoreInfo> _stores;
    private bool _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _stores = await Task.Run(() => StoreService.GetStores().ToList());
        }
        catch
        {
            _error = true;
            _stores = null;
        }
    }
}
