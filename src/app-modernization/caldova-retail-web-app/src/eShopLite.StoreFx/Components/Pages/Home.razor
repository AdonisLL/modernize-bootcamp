@page "/"
@rendermode AppRenderModes.InteractiveServerNoPrerender

<PageTitle>eShopLite &mdash; Home</PageTitle>

<section class="hero mb-5">
    <div class="hero-content">
        <span class="hero-eyebrow"><i class="bi bi-stars"></i> Outdoor gear, modernised</span>
        <h1 class="hero-title">eShopLite</h1>
        <p class="hero-lead">
            Browse and search our outdoor-gear catalogue, open a product for the full details,
            add items to your cart, check out as a signed-in user, and look back over everything
            you have ordered.
        </p>
        <div class="hero-actions">
            <a class="btn btn-primary btn-lg" href="products"><i class="bi bi-grid-3x3-gap"></i> Browse products</a>
            <a class="btn btn-outline-light btn-lg" href="stores"><i class="bi bi-geo-alt"></i> Find a store</a>
        </div>
    </div>
</section>

<div class="row g-4">
    <div class="col-md-4">
        <div class="feature-card h-100">
            <div class="feature-icon"><i class="bi bi-bag-check"></i></div>
            <h2 class="h5">Shop</h2>
            <p>
                Search the catalogue by name or description, open any product for its full details,
                then pick a quantity and add to your cart. The cart follows you until you check out.
            </p>
            <a class="stretched-link link-accent" href="products">Products <i class="bi bi-arrow-right"></i></a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-card h-100">
            <div class="feature-icon"><i class="bi bi-geo-alt"></i></div>
            <h2 class="h5">Stores</h2>
            <p>
                Nine locations, each with its own city and opening hours &mdash; the physical side
                of the catalogue.
            </p>
            <a class="stretched-link link-accent" href="stores">Stores <i class="bi bi-arrow-right"></i></a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-card h-100">
            <div class="feature-icon"><i class="bi bi-receipt"></i></div>
            <h2 class="h5">Your orders</h2>
            <p>
                Every order you have placed, newest first, with a running lifetime total and a link
                back to each receipt. Sign in to see yours &mdash; you only ever see your own.
            </p>
            <a class="stretched-link link-accent" href="orders">My orders <i class="bi bi-arrow-right"></i></a>
        </div>
    </div>
</div>
