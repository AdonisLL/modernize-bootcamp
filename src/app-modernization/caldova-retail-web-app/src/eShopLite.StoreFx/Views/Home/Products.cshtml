@using eShopLite.StoreFx.Models
@model IEnumerable<Product>
@{
  ViewBag.Title = "Products";
  var products = Model;
  var searchTerm = ViewBag.SearchTerm as string;
}
<main aria-labelledby="title">
  <h2 id="title">@ViewBag.Title</h2>
  <h3>@ViewBag.Message</h3>

  @if (TempData["CartMessage"] != null)
  {
    <div class="alert alert-@(TempData["CartMessageKind"] ?? "success")">@TempData["CartMessage"]</div>
  }

  @using (Html.BeginForm("Products", "Home", FormMethod.Get, new { @class = "row g-2 mb-3" }))
  {
    <div class="col-auto">
      <input type="search" name="q" value="@searchTerm" class="form-control" placeholder="Search products" aria-label="Search products" />
    </div>
    <div class="col-auto">
      <button type="submit" class="btn btn-primary">Search</button>
    </div>
    if (!string.IsNullOrWhiteSpace(searchTerm))
    {
      <div class="col-auto">
        @Html.ActionLink("Clear", "Products", "Home", null, new { @class = "btn btn-outline-secondary" })
      </div>
    }
  }

  @if (products == null)
  {
    <p><em>Loading...</em></p>
  }
  else if (!products.Any())
  {
    <p><em>No products matched "@searchTerm".</em></p>
  }
  else
  {
    <table class="table">
      <thead>
        <tr>
          <th>Products ID</th>
          <th>Image</th>
          <th>Details</th>
          <th>Price (USD)</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        @foreach (var product in products)
        {
          <tr>
            <td>@product.Id</td>
            <td>
              <a href="@Url.Action("Product", "Home", new { id = product.Id })">
                <img src="~/images/@product.ImageUrl" alt="@product.Name" width="150">
              </a>
            </td>
            <td>
              <a href="@Url.Action("Product", "Home", new { id = product.Id })"><strong>@product.Name</strong></a><br>
              @product.Description
            </td>
            <td>USD @product.Price.ToString("N2")</td>
            <td>
              @using (Html.BeginForm("Add", "Cart", FormMethod.Post, new { @class = "d-flex gap-2 align-items-center" }))
              {
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@product.Id" />
                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                <label class="visually-hidden" for="qty-@product.Id">Quantity for @product.Name</label>
                <input type="number" id="qty-@product.Id" name="quantity" value="1" min="1"
                       class="form-control form-control-sm" style="width: 5rem;" />
                <button type="submit" class="btn btn-sm btn-outline-primary">Add to cart</button>
              }
            </td>
          </tr>
        }
      </tbody>
    </table>
  }
</main>
