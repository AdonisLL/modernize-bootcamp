@using eShopLite.StoreFx.Models
@model Product
@* Rendered through a cached view component - must stay free of user- or session-specific data. *@
<div class="col-md-5">
  <img src="~/images/@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded border" />
</div>
<div class="col-md-7">
  <h2 id="title">@Model.Name</h2>
  <p class="fs-4">USD @Model.Price.ToString("N2")</p>
  <p>@Model.Description</p>
</div>
