@using eShopLite.StoreFx.Models
@using eShopLite.StoreFx.Services
@inject ISessionStore Session
@{
  // LEGACY BY DESIGN: the view reads session directly instead of receiving a view model.
  var cart = Session.Get<Cart>(SessionCartService.SessionKey) ?? new Cart();
}
<a href="@Url.Action("Index", "Cart")" class="nav-link position-relative d-inline-flex align-items-center" aria-label="Cart (@cart.ItemCount items)">
  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
    <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .49.598l-1 5a.5.5 0 0 1-.465.401l-9.397.472L4.415 11H13a.5.5 0 0 1 0 1H4a.5.5 0 0 1-.491-.408L1.61 2H.5a.5.5 0 0 1-.5-.5zM5 14a1 1 0 1 1 0-2 1 1 0 0 1 0 2zm7 0a1 1 0 1 1 0-2 1 1 0 0 1 0 2z" />
  </svg>
  <span class="ms-1">Cart</span>
  @if (cart.ItemCount > 0)
  {
    <span class="badge rounded-pill bg-primary ms-1">@cart.ItemCount</span>
  }
</a>
