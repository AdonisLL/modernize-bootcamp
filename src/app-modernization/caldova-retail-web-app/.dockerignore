# Source-control metadata
.git
.gitignore
.gitattributes
.github
.vs
.vscode

# Build output (restored fresh inside the build stage)
**/bin
**/obj
**/out
**/publish
**/TestResults

# Local secret / credential files that must never enter the image
**/connectionStrings.config
**/appsettings.*.Local.json
**/*.user
**/*.userosscache
**/secrets.json
**/*.pfx
**/*.p12
**/.env
**/.env.*

# Docker and container artifacts
**/Dockerfile*
**/.dockerignore

# Editor / OS noise
**/*.suo
**/.DS_Store
**/Thumbs.db
